// features.kc - turns a game into the vector the Q-network sees.
//
// The encoding is *egocentric*: everything is expressed relative to the snake's heading ("danger to my left",
// "food ahead"), so the network never has to learn four rotated copies of the same behaviour.
//
//   idx  name              meaning
//    0-2 danger_l/s/r      1 if the adjacent cell on that side is a wall or body
//    3-6 dir_up/right/down/left   absolute heading, one-hot
//    7-10 food_ahead/behind/left/right   which half-planes the food lies in (relative to the heading)
//   11   food_dist         Manhattan distance to the food, normalised to 0..1
//   12-14 ray_l/s/r        free cells before the first obstacle along each side, / board size
//   15-17 space_l/s/r      flood-fill: fraction of the free board still reachable after moving that way
//   18   length            snake length / board cells
//
// The three `space_*` features are what stops the snake from boxing itself into a pocket. They cost one
// flood fill per direction and can be switched off (`features.flood = false`), in which case they read 0.
import "env.kc" as env;

let NAMES = [
    "danger_left", "danger_straight", "danger_right",
    "dir_up", "dir_right", "dir_down", "dir_left",
    "food_ahead", "food_behind", "food_left", "food_right",
    "food_dist",
    "ray_left", "ray_straight", "ray_right",
    "space_left", "space_straight", "space_right",
    "length"
];
let DIM = 19;

/// Cells reachable from (r, c) by 4-neighbour moves through free cells (the tail cell counts as free).
fn flood_area(g: object, r: int, c: int) -> int {
    let size = g["size"];
    if (env.blocked(g, r, c)) { return 0; }
    let vis = g["occ"].slice(0, size * size);
    let snake = g["snake"];
    let tail = snake[len(snake) - 1];
    vis[tail[0] * size + tail[1]] = 0;
    let start = r * size + c;
    vis[start] = 1;
    let stack = [start];
    var count = 0;
    while (len(stack) > 0) {
        let i = stack.pop();
        count += 1;
        let rr = int(i / size);
        let cc = i - rr * size;
        if (rr > 0 && vis[i - size] == 0) { vis[i - size] = 1; stack.push(i - size); }
        if (rr < size - 1 && vis[i + size] == 0) { vis[i + size] = 1; stack.push(i + size); }
        if (cc > 0 && vis[i - 1] == 0) { vis[i - 1] = 1; stack.push(i - 1); }
        if (cc < size - 1 && vis[i + 1] == 0) { vis[i + 1] = 1; stack.push(i + 1); }
    }
    return count;
}

/// Number of consecutive free cells straight ahead of (r, c) in direction d.
fn ray_length(g: object, r: int, c: int, d: int) -> int {
    var n = 0;
    var rr = r + env.DR[d];
    var cc = c + env.DC[d];
    while (!env.blocked(g, rr, cc)) {
        n += 1;
        rr += env.DR[d];
        cc += env.DC[d];
    }
    return n;
}

/// Encode the current game state as DIM floats.
fn encode(g: object, flood: bool = true) -> array {
    let size = g["size"];
    let head = g["snake"][0];
    let hr = head[0];
    let hc = head[1];
    let dir = g["dir"];
    let dl = (dir + 3) % 4;
    let dr = (dir + 1) % 4;
    let dirs = [dl, dir, dr];

    let f = [];
    // danger and free-ray length for left / straight / right
    for (d in dirs) {
        var v = 0.0;
        if (env.blocked(g, hr + env.DR[d], hc + env.DC[d])) { v = 1.0; }
        f.push(v);
    }
    for (k in 0..4) {
        if (dir == k) { f.push(1.0); } else { f.push(0.0); }
    }

    // food, relative to the heading
    let food = g["food"];
    var ahead = 0.0;
    var behind = 0.0;
    var left = 0.0;
    var right = 0.0;
    var dist = 0.0;
    if (food != null) {
        let dy = food[0] - hr;
        let dx = food[1] - hc;
        let fwd = dy * env.DR[dir] + dx * env.DC[dir];
        let side = dy * env.DR[dr] + dx * env.DC[dr];
        if (fwd > 0) { ahead = 1.0; }
        if (fwd < 0) { behind = 1.0; }
        if (side > 0) { right = 1.0; }
        if (side < 0) { left = 1.0; }
        dist = (abs(dy) + abs(dx)) / (2.0 * (size - 1));
    }
    f.push(ahead);
    f.push(behind);
    f.push(left);
    f.push(right);
    f.push(dist);

    for (d in dirs) { f.push(ray_length(g, hr, hc, d) / size); }

    let free = size * size - len(g["snake"]);
    for (d in dirs) {
        var area = 0.0;
        if (flood && free > 0) {
            area = flood_area(g, hr + env.DR[d], hc + env.DC[d]) / free;
            if (area > 1.0) { area = 1.0; }
        }
        f.push(area);
    }
    f.push(len(g["snake"]) / (size * size));
    return f;
}
