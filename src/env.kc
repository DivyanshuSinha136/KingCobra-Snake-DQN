// env.kc - the Snake environment.
//
// A game is a plain object (see `new_game`) that the functions below mutate. The environment is
// deliberately free of any learning code: the agent, the trainer and the web server all drive it through
// `new_game`, `step` and `public_view`.
//
// Directions are 0 = up, 1 = right, 2 = down, 3 = left. Agents act in *relative* terms:
//     0 = go straight     1 = turn left     2 = turn right
import "util.kc" as util;

let DR = [-1, 0, 1, 0];
let DC = [0, 1, 0, -1];
let ACTION_NAMES = ["straight", "left", "right"];
let N_ACTIONS = 3;

/// Heading after applying a relative action.
fn turn(dir: int, action: int) -> int {
    if (action == 1) { return (dir + 3) % 4; }
    if (action == 2) { return (dir + 1) % 4; }
    return dir;
}

/// Relative action that turns `dir` into `want`, or -1 for a 180-degree reversal (not a legal move).
fn relative_action(dir: int, want: int) -> int {
    if (want == dir) { return 0; }
    if (want == (dir + 3) % 4) { return 1; }
    if (want == (dir + 1) % 4) { return 2; }
    return -1;
}

/// Pick a uniformly random free cell for the food. Returns null if the board is full.
fn place_food(g: object) -> any {
    let size = g["size"];
    let free = size * size - len(g["snake"]);
    if (free <= 0) { return null; }
    var k = util.below(free);
    let occ = g["occ"];
    for (i in 0..size * size) {
        if (occ[i] == 0) {
            if (k == 0) { return [int(i / size), i % size]; }
            k -= 1;
        }
    }
    return null;
}

/// A fresh game: a length-3 snake in the middle of the board, heading right.
fn new_game(size: int = 10, idle_base: int = 100, idle_per_len: int = 2, max_steps: int = 3000) -> object {
    let mid = int(size / 2);
    let occ = [0; size * size];
    let snake = [[mid, mid], [mid, mid - 1], [mid, mid - 2]];
    for (seg in snake) { occ[seg[0] * size + seg[1]] = 1; }
    let g = {
        size: size, snake: snake, occ: occ, food: [0, 0], dir: 1,
        score: 0, steps: 0, idle: 0, done: false, cause: "", ate: false,
        idle_base: idle_base, idle_per_len: idle_per_len, max_steps: max_steps
    };
    g["food"] = place_food(g);
    return g;
}

/// True if a snake head cannot enter (r, c) right now. The cell the tail is about to leave counts as free,
/// exactly as in the real game.
fn blocked(g: object, r: int, c: int) -> bool {
    let size = g["size"];
    if (r < 0 || r >= size || c < 0 || c >= size) { return true; }
    let i = r * size + c;
    if (g["occ"][i] == 0) { return false; }
    let snake = g["snake"];
    let tail = snake[len(snake) - 1];
    return i != tail[0] * size + tail[1];
}

/// Advance one tick. `rw` holds the reward weights (food, death, step, win, shaping, starve).
/// Returns the reward. Afterwards `g["done"]` / `g["cause"]` ("wall" | "self" | "starved" | "timeout" | "win")
/// describe how the episode ended and `g["ate"]` says whether this step ate the food.
fn step(g: object, action: int, rw: object) -> float {
    if (g["done"]) { return 0.0; }
    let size = g["size"];
    let snake = g["snake"];
    let occ = g["occ"];
    let ndir = turn(g["dir"], action);
    g["dir"] = ndir;
    g["steps"] += 1;
    g["ate"] = false;

    let head = snake[0];
    let nr = head[0] + DR[ndir];
    let nc = head[1] + DC[ndir];

    if (blocked(g, nr, nc)) {
        g["done"] = true;
        if (nr < 0 || nr >= size || nc < 0 || nc >= size) { g["cause"] = "wall"; } else { g["cause"] = "self"; }
        return rw["death"];
    }

    let food = g["food"];
    let ate = (food != null && nr == food[0] && nc == food[1]);
    var before = 0;
    if (food != null) { before = abs(head[0] - food[0]) + abs(head[1] - food[1]); }

    if (!ate) {
        let tail = snake.pop();
        occ[tail[0] * size + tail[1]] = 0;
    }
    snake.insert(0, [nr, nc]);
    occ[nr * size + nc] = 1;

    var reward = rw["step"];
    if (ate) {
        g["score"] += 1;
        g["idle"] = 0;
        g["ate"] = true;
        reward = rw["food"];
        g["food"] = place_food(g);
        if (g["food"] == null) {
            g["done"] = true;
            g["cause"] = "win";
            return reward + rw["win"];
        }
    } else {
        g["idle"] += 1;
        if (food != null) {
            let after = abs(nr - food[0]) + abs(nc - food[1]);
            if (after < before) { reward += rw["shaping"]; } else { reward -= rw["shaping"]; }
        }
        if (g["idle"] > g["idle_base"] + g["idle_per_len"] * len(snake)) {
            g["done"] = true;
            g["cause"] = "starved";
            return rw["starve"];
        }
    }
    if (g["steps"] >= g["max_steps"]) {
        g["done"] = true;
        g["cause"] = "timeout";
    }
    return reward;
}

/// The JSON-friendly view of a game that the web UI draws.
fn public_view(g: object) -> object {
    return {
        size: g["size"], snake: g["snake"], food: g["food"], dir: g["dir"],
        score: g["score"], steps: g["steps"], length: len(g["snake"]),
        done: g["done"], cause: g["cause"]
    };
}

/// ASCII rendering for the terminal `watch` command.
fn render_ascii(g: object) -> string {
    let size = g["size"];
    let snake = g["snake"];
    var lines = [];
    var top = "+";
    for (c in 0..size) { top += "--"; }
    top += "+";
    lines.push(top);
    for (r in 0..size) {
        var row = "|";
        for (c in 0..size) {
            var ch = " .";
            if (g["food"] != null && g["food"][0] == r && g["food"][1] == c) { ch = " *"; }
            if (g["occ"][r * size + c] == 1) { ch = " o"; }
            if (snake[0][0] == r && snake[0][1] == c) { ch = " @"; }
            row += ch;
        }
        row += "|";
        lines.push(row);
    }
    lines.push(top);
    return lines.join("\n");
}
