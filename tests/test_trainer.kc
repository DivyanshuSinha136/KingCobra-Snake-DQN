// Training end to end (tiny run): artefacts are written, runs are reproducible, evaluation is sane.
import std.system;
import std.io;
import std.json;
import "../src/config.kc" as config;
import "../src/trainer.kc" as trainer;

fn tiny(dir: string) -> object {
    let c = config.defaults();
    c["train"]["episodes"] = 6;
    c["train"]["eval_every"] = 3;
    c["train"]["eval_episodes"] = 2;
    c["train"]["final_eval_episodes"] = 3;
    c["train"]["log_every"] = 3;
    c["train"]["out_dir"] = dir;
    c["train"]["name"] = "tiny";
    c["replay"]["batch"] = 8;
    c["replay"]["capacity"] = 64;
    c["replay"]["warmup"] = 16;
    c["agent"]["hidden"] = [8];
    config.validate(c);
    return c;
}

fn test_training_writes_artefacts() {
    let dir = system.make_temp_dir("kc_snake_train_");
    defer system.rmdir(dir, true);
    let res = trainer.train(tiny(dir), false);
    let p = trainer.paths(tiny(dir));
    assert(io.exists(p["model"]));
    assert(io.exists(p["card"]));
    assert(io.exists(p["metrics"]));
    let card = json.parse(io.read_file(p["card"]));
    assert_eq(card["episodes"], 6);
    assert_eq(card["input_dim"], 19);
    assert_eq(card["network"], [19, 8, 3]);
    assert_eq(card["config"]["train"]["out_dir"], "models");     // no machine-specific path in the card
    let m = json.parse(io.read_file(p["metrics"]));
    assert_eq(len(m["history"]), 2);
    assert_eq(m["history"][1]["episode"], 6);
}

fn test_same_seed_same_result() {
    let d1 = system.make_temp_dir("kc_snake_a_");
    let d2 = system.make_temp_dir("kc_snake_b_");
    defer system.rmdir(d1, true);
    defer system.rmdir(d2, true);
    let a = trainer.train(tiny(d1), false);
    let b = trainer.train(tiny(d2), false);
    assert_eq(a["card"]["final_eval"]["mean"], b["card"]["final_eval"]["mean"]);
    assert_eq(a["card"]["total_steps"], b["card"]["total_steps"]);
    assert_eq(a["history"][0]["loss"], b["history"][0]["loss"]);
    assert_eq(io.read_file(trainer.paths(tiny(d1))["model"]), io.read_file(trainer.paths(tiny(d2))["model"]));
}

fn test_n_step_window_emits_discounted_return() {
    let rb = {
        S: [], A: [], R: [], S2: [], D: [], G: [], count: 0, capacity: 10, head: 0, prioritized: false
    };
    // three steps with rewards 1, 2, 3; gamma 0.5 -> 1 + 0.5*2 + 0.25*3 = 2.75, bootstrap discount 0.125
    let w = [[[0.0], 0, 1.0, [1.0], 0], [[1.0], 1, 2.0, [2.0], 0], [[2.0], 2, 3.0, [3.0], 1]];
    trainer.emit(rb, w, 0, 0.5);
    assert_eq(rb["R"][0], 2.75);
    assert_eq(rb["G"][0], 0.125);
    assert_eq(rb["D"][0], 1);
    assert_eq(rb["S2"][0], [3.0]);
    trainer.emit(rb, w, 2, 0.5);                       // truncated tail: just the last step
    assert_eq(rb["R"][1], 3.0);
    assert_eq(rb["G"][1], 0.5);
}

fn test_evaluate_reports_consistent_numbers() {
    let dir = system.make_temp_dir("kc_snake_eval_");
    defer system.rmdir(dir, true);
    let res = trainer.train(tiny(dir), false);
    let r = trainer.evaluate(res["agent"], tiny(dir), 5);
    assert_eq(r["episodes"], 5);
    assert_eq(len(r["scores"]), 5);
    let d = r["deaths"];
    assert_eq(d["wall"] + d["self"] + d["starved"] + d["win"], 5);
    assert(r["max"] >= r["mean"]);
}
